---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				text-align: center;
				padding: 3rem 1rem 2rem;
			}
			.hero .wave {
				font-size: 3rem;
				line-height: 1;
				margin-bottom: 0.5rem;
			}
			.hero h1 {
				font-size: 2rem;
				margin: 0 0 1rem;
				line-height: 1.3;
			}
			.hero p {
				color: rgb(var(--gray));
				max-width: 40rem;
				margin: 0 auto;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="wave">👋</div>
				<h1>你好，欢迎来到我的博客</h1>
				<p>在这里记录学习、思考与生活。</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
