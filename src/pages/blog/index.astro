---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Clock from '../../components/Clock.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-list li {
				margin: 0 0 2.2em;
			}
			.post-list a {
				text-decoration: none;
				display: block;
			}
			.post-list h2 {
				margin: 0 0 0.35em;
				font-size: 1.15em;
				color: rgb(var(--black));
				line-height: 1.45;
				transition: color 0.15s ease;
			}
			.post-list a:hover h2 {
				color: var(--accent);
			}
			.post-meta {
				margin: 0 0 0.4em;
				color: rgb(var(--gray));
				font-size: 0.85em;
			}
			.post-meta .category::after {
				content: '·';
				margin: 0 0.5em;
			}
			.post-desc {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.92em;
				line-height: 1.65;
			}
			.empty {
				color: rgb(var(--gray));
			}
			.page-clock {
				margin-top: 4em;
				text-align: center;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			{
				posts.length === 0 ? (
					<p class="empty">还没有文章。</p>
				) : (
					<ul class="post-list">
						{posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<h2>{post.data.title}</h2>
									<p class="post-meta">
										{post.data.category && <span class="category">{post.data.category}</span>}
										<FormattedDate date={post.data.pubDate} />
									</p>
									<p class="post-desc">{post.data.description}</p>
								</a>
							</li>
						))}
					</ul>
				)
			}
			<div class="page-clock"><Clock /></div>
		</main>
		<Footer />
	</body>
</html>
