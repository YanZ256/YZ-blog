---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & { hideDate?: boolean };

const { title, description, pubDate, updatedDate, heroImage, category, hideDate } = Astro.props;
---

<html lang="zh">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.hero-image {
				margin-bottom: 2.5em;
			}
			.hero-image img {
				display: block;
				width: 100%;
				border-radius: 8px;
			}
			.post-header {
				margin-bottom: 2.5em;
			}
			.post-header h1 {
				margin: 0 0 0.6em;
				font-size: 1.75em;
				line-height: 1.35;
			}
			.meta {
				display: flex;
				align-items: center;
				gap: 0.8em;
				color: rgb(var(--gray));
				font-size: 0.88em;
			}
			.category {
				color: rgb(var(--gray));
			}
			.category::after {
				content: '·';
				margin-left: 0.8em;
			}
			.last-updated-on {
				color: rgb(var(--gray));
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}
				<header class="post-header">
					<h1>{title}</h1>
					<div class="meta">
						{category && <span class="category">{category}</span>}
						{!hideDate && <FormattedDate date={pubDate} />}
						{
							updatedDate && (
								<span class="last-updated-on">
									· 更新于 <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
